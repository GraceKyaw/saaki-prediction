# ---- instructions/ is strictly local — never committed, folder and all ----
instructions/

# ---- data/ is strictly local — NOTHING inside it is ever committed ----
# This blanket rule covers every file type and every subdirectory.
# Only the .gitkeep placeholder is tracked, to keep the folder in the repo.
data/*
!data/.gitkeep

# ---- Patient-level data anywhere else in the tree ----
# Never commit extracted cohorts, features, splits or predictions.
*.csv
*.parquet
*.feather
*.pkl
*.pickle
*.h5
*.hdf5
*.dta
*.sav
*.xlsx
*.xls

# Exception: reference lookup tables are code-adjacent config, not patient
# data, and are meant to be tracked (e.g. tier1_outlier_bounds.csv).
!src/reference/*.csv

# ---- Trained models / large binaries ----
*.joblib
*.model
*.pt
*.pth
*.onnx

# ---- OS cruft ----
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ---- Office lock files ----
~$*

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

# ---- Jupyter ----
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ---- Environments / secrets ----
.env
.env.*
*.pem
*.key
credentials.json
service-account*.json
.bigqueryrc

# ---- Editors / tooling ----
.vscode/
.idea/
*.swp
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ---- Logs ----
*.log
logs/
