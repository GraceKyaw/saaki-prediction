# ---- Patient-level data (MIMIC / eICU derived, credentialed access) ----
# Never commit extracted cohorts, features, splits or predictions.
*.csv
*.parquet
*.feather
*.pkl
*.pickle
*.h5
*.hdf5
*.dta
*.sav
*.xlsx
*.xls

# ---- Trained models / large binaries ----
*.joblib
*.model
*.pt
*.pth
*.onnx

# ---- OS cruft ----
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# ---- Office lock files ----
~$*

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version

